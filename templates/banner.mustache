{{!
    @template local_credentiumclaim/banner

    Reminder banner shown to learners who have an unclaimed Credentium credential.

    Context variables required for this template:
    * title - Banner heading.
    * message - Banner body text.
    * cta - Label for the primary action button.
    * ctaurl - URL of the "My credentials" page.
    * dismisslabel - Label for the dismiss control.
    * dismissurl - URL of the dismiss endpoint.
    * sesskey - Session key for the dismiss form.

    Example context (json):
    {
        "title": "You have a new digital credential to claim",
        "message": "Credentium has issued you 1 digital credential(s) that you have not claimed yet.",
        "cta": "Claim now",
        "ctaurl": "https://example.com/local/credentiumclaim/mycredentials.php",
        "dismisslabel": "Dismiss",
        "dismissurl": "https://example.com/local/credentiumclaim/dismiss.php",
        "sesskey": "abcdef1234"
    }
}}
<div class="alert alert-info alert-dismissible local-credentiumclaim-banner d-flex flex-wrap align-items-center" role="status">
    <div class="mr-auto pr-3">
        <strong>{{title}}</strong>
        <div>{{message}}</div>
    </div>
    <div class="d-flex align-items-center mt-2 mt-sm-0">
        <a class="btn btn-primary btn-sm mr-2" href="{{ctaurl}}">{{cta}}</a>
        <form method="post" action="{{dismissurl}}" class="m-0">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-link btn-sm">{{dismisslabel}}</button>
        </form>
    </div>
</div>
